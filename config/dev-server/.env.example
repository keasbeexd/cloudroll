# scripts/dev-server.sh creates .env from this automatically with random passwords.
# LAN IP of the machine running the server; the iPhone connects to https://HOST_IP:HTTPS_PORT
HOST_IP=192.168.1.10
HTTPS_PORT=8443
# Database password for the nextcloud user
DB_PASSWORD=change-me
# Password for the Nextcloud "admin" account
ADMIN_PASSWORD=change-me
